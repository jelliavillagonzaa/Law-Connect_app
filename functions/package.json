{
  "name": "law-connect-functions",
  "description": "Court email ingest → calendar_events (Law Connect)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "deploy:ingest": "npm run build && firebase deploy --only functions:courtEmailIngest,functions:imapCourtEmailIngest,functions:imapCourtEmailManual,functions:onCourtEmailQueueNotify,functions:onCourtEmailNotificationSuppress,functions:processCourtEmailQueue",
    "lint": "eslint --ext .js,.ts src",
    "test:philsms": "node scripts/test-philsms.mjs",
    "test:hearing-reminders": "node scripts/test-hearing-reminders.mjs"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.0",
    "nodemailer": "^6.9.16",
    "twilio": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.5.0"
  },
  "private": true
}
